# syntax=docker/dockerfile:1.7

# Build the React management console.
FROM node:22-alpine AS web-builder

WORKDIR /app

ENV CI=true
ARG PNPM_REGISTRY=https://registry.npmmirror.com

RUN corepack enable && corepack prepare pnpm@11.21.0 --activate

COPY main/manager-web-next/package.json main/manager-web-next/pnpm-lock.yaml ./

RUN --mount=type=cache,id=xiaozhi-manager-web-pnpm,target=/pnpm/store \
    pnpm config set registry "${PNPM_REGISTRY}" && \
    pnpm config set store-dir /pnpm/store && \
    pnpm install --frozen-lockfile

COPY main/manager-web-next ./

RUN pnpm build

# Build the Java management API that is served by the same container.
FROM maven:3.9.4-eclipse-temurin-21 AS api-builder

WORKDIR /app

COPY main/manager-api/pom.xml ./
COPY main/manager-api/src ./src

RUN --mount=type=cache,id=xiaozhi-manager-api-maven,target=/root/.m2 \
    mvn -B -ntp clean package -Dmaven.test.skip=true

# Runtime image: Nginx serves React and proxies /xiaozhi to the Java API.
FROM bellsoft/liberica-runtime-container:jre-21-glibc

RUN apk add --no-cache --no-scripts \
        bash \
        fontconfig \
        nginx \
        ttf-dejavu \
    && mkdir -p /run/nginx /var/log/nginx /var/tmp/nginx /etc/nginx/conf.d

# The device-theme generator still needs these fonts at runtime.
COPY main/manager-web-next/public/generator/static/fonts/*.ttf /usr/share/fonts/
RUN fc-cache -f

COPY docs/docker/nginx.conf /etc/nginx/nginx.conf
COPY --from=web-builder /app/dist /usr/share/nginx/html

COPY --from=api-builder /app/target/xiaozhi-esp32-api.jar /app/xiaozhi-esp32-api.jar
COPY docs/docker/start.sh /start.sh

RUN chmod +x /start.sh

ENV SERVER_PORT=8003

EXPOSE 8002

HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=5 \
    CMD wget -q -O /dev/null http://127.0.0.1:8002/xiaozhi/user/pub-config || exit 1

CMD ["/start.sh"]
