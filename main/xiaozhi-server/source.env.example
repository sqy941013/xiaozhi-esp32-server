# Copy this file to .env and replace the password before the first deployment.
COMPOSE_PROJECT_NAME=xiaozhi-all
XIAOZHI_SOURCE_DIR=../..
XIAOZHI_RUNTIME_DIR=.

XIAOZHI_SERVER_REPOSITORY=xiaozhi-esp32-server
XIAOZHI_WEB_REPOSITORY=xiaozhi-esp32-server-web
XIAOZHI_WS_PORT=8000
XIAOZHI_WEB_PORT=8002
XIAOZHI_VISION_PORT=8003

MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=

# React dependencies use this registry by default.
PNPM_REGISTRY=https://registry.npmmirror.com

# Optional build proxy. Docker treats these as predefined proxy build arguments
# and does not persist them in image metadata unless a Dockerfile references them.
# HTTP_PROXY=http://192.168.123.135:20171
# HTTPS_PROXY=http://192.168.123.135:20171
# NO_PROXY=127.0.0.1,localhost
